generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id           Int     @id(map: "users_pkey") @default(autoincrement())
  name         String  @db.VarChar(100)
  email        String  @unique(map: "users_email_key") @db.VarChar(100)
  phone_number String? @db.VarChar(15)
  address      String?
  events       Event[]
}

model EventCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String?
  events      Event[]
}

model Event {
  eventid       Int            @id @default(autoincrement())
  clientid      Int?
  eventdate     DateTime?      @db.Date
  categoryid    Int?
  guestcount    Int?
  notes         String?
  venueid       Int?
  name          String?         @db.VarChar
  eventcategory EventCategory? @relation(fields: [categoryid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  client        Client?        @relation(fields: [clientid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venue         Venue?         @relation(fields: [venueid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quoteAmount   Decimal?        @db.Decimal(10, 2) // Quoted price for the event
  paidAmount    Decimal?        @db.Decimal(10, 2) // Amount paid by the client
  expenseAmount Decimal?        @db.Decimal(10, 2)
  decorItemUsages DecorItemUsage[]
}

model Venue {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(255)
  type     VenueType
  address  String?
  capacity Int?
  notes    String?
  events   Event[]
}

enum VenueType {
  CHURCH
  HALL
  RESTAURANT
  HOUSE
  OTHER
}

model DecorItem {
  id          Int                @id @default(autoincrement())
  name        String             @unique @db.VarChar(255)
  description String?
  unitPrice   Decimal            @db.Decimal(10, 2)
  stockQuantity Int              @default(0)
  decorItemUsages DecorItemUsage[]
}

model DecorItemUsage {
  id          Int     @id @default(autoincrement())
  eventId     Int
  decorItemId Int
  quantity    Int     @default(1)
  notes       String?
  event       Event   @relation(fields: [eventId], references: [eventid], onDelete: Cascade, onUpdate: NoAction)
  decorItem   DecorItem @relation(fields: [decorItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([eventId])
  @@index([decorItemId])
}
